# Database Configuration
# For local development (SQLite)
DATABASE_URL=sqlite:///sales_orders.db
# For PostgreSQL (Railway/Render)
# DATABASE_URL=postgresql://user:password@host:port/database

# AI Configuration (Required)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Email Configuration (Required for email processing)
IMAP_SERVER=imap.gmail.com
SMTP_SERVER=smtp.gmail.com
EMAIL_ACCOUNT=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_or_smtp_password

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO
PORT=8000
ENVIRONMENT=development

# Worker Configuration
WORKER_EMAIL_INTERVAL_MINUTES=2
WORKER_WORKFLOW_INTERVAL_SECONDS=60

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Railway/Render specific (uncomment when deploying)
# RAILWAY_STATIC_URL=
# RENDER_EXTERNAL_URL=
